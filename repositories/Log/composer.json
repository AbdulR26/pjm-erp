{
  "name": "qollam/log",
  "version": "1.0.0",
  "description": "Qollam data log module",
  "keywords": [
    "data",
    "log"
  ],
  "license": "MIT",
  "homepage": "http://qollamsolutions.com/",
  "support": {
    "issues": "https://github.com/qollam/log/issues",
    "source": "https://github.com/qollam/log"
  },
  "authors": [
    {
      "name": "Agus Saiful M",
      "email": "agusgrasm@gmail.com"
    }
  ],
  "require": {
    "php": "^7.1.3"
  },
  "autoload": {
    "psr-4": {
      "Qollam\\Log\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Qollam\\Log\\LogServiceProvider"
      ],
      "aliases": {
        "Log": "Qollam\\Log\\LogFacade"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
